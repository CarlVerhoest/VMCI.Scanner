{
  "ConnectionStrings": {
    // Empty on purpose: each environment supplies its own (appsettings.Development.json locally).
    "DefaultConnection": ""
  },
  "Jwt": {
    // Empty on purpose: the key lives in backend/secrets/appsettings.secrets.json (gitignored), one per
    // machine or server. A fresh random value per project, at least 32 characters; never reuse another
    // project's key. The API refuses to start without it - see docs/security.md.
    "Key": "",
    "Issuer": "Scanner",
    "Audience": "Scanner",
    "ExpirationHours": "24"
  },
  "Frontend": {
    "BaseUrl": ""
  },
  "StaticFiles": {
    "Enabled": true,
    "Path": "wwwroot"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/scanner-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj}{NewLine}{Exception}",
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
