{
  "ConnectionStrings": {
    // Empty on purpose: each environment supplies its own (appsettings.Development.json locally).
    "DefaultConnection": ""
  },
  "DataProtection": {
    // Where the keys that encrypt the login cookie are kept. Must survive restarts and deployments, or
    // every restart signs out every device. Empty: <content root>/../secrets/data-protection-keys.
    "KeysPath": ""
  },
  "DocumentIntelligence": {
    // OCR for searchable PDFs. Registered only when Endpoint AND Key are set; without them PDFs are
    // image-only. The Key is a secret: backend/secrets/appsettings.secrets.json, never here.
    "Endpoint": "",
    "Key": "",
    "ModelId": "prebuilt-read"
  },
  "Anthropic": {
    // Claude proposes a document name from the OCR text. Registered only when ApiKey is set; without it
    // the document keeps the name the client sent. The key is a secret and Scanner's own (not shared
    // with another application): backend/secrets/appsettings.secrets.json, never here.
    "ApiKey": "",
    "TitleModel": "claude-opus-5-5",
    "TitleTimeoutSeconds": 20
  },
  "Email": {
    // Microsoft Graph, app-only with a certificate, sending as the shared mailbox below. Registered only
    // when every value is set, CertificatePassword included; without it the email endpoint answers 503.
    // The IDs are public identifiers, not secrets. The certificate file and its password live in the
    // secrets folder (CertificatePath is relative to it). Tenant setup and record: docs/mail-setup.md.
    "TenantId": "731f7ac2-3189-44d3-b1df-bf5bd3405cfc",
    "ClientId": "3b079a6f-457a-4e3a-96f7-5fba81168911",
    "SenderAddress": "noreply@vmci.be",
    "CertificatePath": "scanner-mail.pfx",
    "CertificatePassword": "",
    "MaxMessageBytes": 9437184
  },
  "Limits": {
    "MaxPages": 20,
    "MaxPageBytes": 1572864,
    "LoginAttemptsPer15Minutes": 10
  },
  "Frontend": {
    "BaseUrl": ""
  },
  "StaticFiles": {
    "Enabled": true,
    "Path": "wwwroot"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/scanner-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj}{NewLine}{Exception}",
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
