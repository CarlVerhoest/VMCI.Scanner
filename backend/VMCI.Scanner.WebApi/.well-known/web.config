<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!--
      Serve /.well-known straight from disk instead of through the API, so Plesk's Let's Encrypt renewal
      (ACME HTTP-01 challenge files under .well-known/acme-challenge) keeps working.
      Lives in the site root, not in wwwroot: IIS maps the URL /.well-known to <site root>\.well-known.
    -->
    <handlers>
      <remove name="aspNetCore" />
      <add name="StaticFile" path="*" verb="*" modules="StaticFileModule" resourceType="Either" requireAccess="Read" />
    </handlers>
    <staticContent>
      <mimeMap fileExtension="." mimeType="text/plain" />
    </staticContent>
  </system.webServer>
</configuration>
