{
  "worktree": {
    "bgIsolation": "none"
  },
  "permissions": {
    "allow": [
      "Bash(dotnet --version)",
      "Bash(dotnet --list-sdks)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet run:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet sln:*)",
      "Bash(dotnet ef:*)",

      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm audit:*)",
      "Bash(npm view:*)",
      "Bash(npm dist-tag:*)",
      "Bash(npm ls:*)",

      "Bash(npx vitest:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",

      "Bash(git diff:*)",
      "Bash(git --no-pager diff:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",

      "PowerShell(dotnet --version)",
      "PowerShell(dotnet --list-sdks)",
      "PowerShell(dotnet build:*)",
      "PowerShell(dotnet test:*)",
      "PowerShell(dotnet run:*)",
      "PowerShell(dotnet format:*)",
      "PowerShell(dotnet restore:*)",
      "PowerShell(dotnet sln:*)",
      "PowerShell(dotnet ef:*)",

      "PowerShell(npm run:*)",
      "PowerShell(npm test:*)",
      "PowerShell(npm install:*)",
      "PowerShell(npm uninstall:*)",
      "PowerShell(npm audit:*)",
      "PowerShell(npm view:*)",
      "PowerShell(npm dist-tag:*)",
      "PowerShell(npm ls:*)",

      "PowerShell(npx vitest:*)",
      "PowerShell(npx tsc:*)",
      "PowerShell(npx eslint:*)",
      "PowerShell(npx prettier:*)",

      "PowerShell(git diff:*)",
      "PowerShell(git --no-pager diff:*)",
      "PowerShell(git status:*)",
      "PowerShell(git log:*)",
      "PowerShell(git show:*)"
    ]
  }
}
