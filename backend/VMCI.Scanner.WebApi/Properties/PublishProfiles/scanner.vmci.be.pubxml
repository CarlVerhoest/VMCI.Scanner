<?xml version="1.0" encoding="utf-8"?>
<!--
  Visual Studio publish profile for the API on scanner.vmci.be (Plesk, Web Deploy on port 8172), modelled on
  LevelUp's. Committed on purpose, WITHOUT the password: Visual Studio asks for it on publish. If you tick
  "Save password" it goes, DPAPI-encrypted and per machine, into scanner.vmci.be.pubxml.user, which is
  gitignored (*.user). The SPA in wwwroot/ is deployed separately by frontend/VMCI.Scanner.App/deploy.ps1.
  See docs/deployment.md.
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <TargetFramework>net10.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <SiteUrlToLaunchAfterPublish>https://scanner.vmci.be/api/info/version</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <MSDeployServiceURL>https://vmci.be:8172/msdeploy.axd?site=scanner.vmci.be</MSDeployServiceURL>
    <DeployIisAppPath>scanner.vmci.be</DeployIisAppPath>
    <RemoteSitePhysicalPath />
    <MSDeployPublishMethod>WMSVC</MSDeployPublishMethod>
    <!-- Removes files on the server that are no longer published - except what the skip rules below protect. -->
    <SkipExtraFilesOnServer>false</SkipExtraFilesOnServer>
    <EnableMsDeployAppOffline>true</EnableMsDeployAppOffline>
    <EnableMSDeployBackup>false</EnableMSDeployBackup>
    <!-- Plesk's certificate on port 8172 is not trusted by Windows. -->
    <AllowUntrustedCertificate>true</AllowUntrustedCertificate>
    <UserName />
    <_SavePWD>false</_SavePWD>
  </PropertyGroup>

  <!--
    Never touch these on the server. The regexes match the path on both sides, so nothing from them is
    uploaded either.
    - secrets: the production credentials (uploaded by hand) AND the Data Protection keys. Deleting the keys
      signs every user out on every device.
    - wwwroot: the SPA, owned by the frontend deploy.
    - logs: the Serilog files.
    - .well-known\acme-challenge: Let's Encrypt files Plesk writes during a renewal.
  -->
  <ItemGroup>
    <MsDeploySkipRules Include="SkipSecretsFolder">
      <ObjectName>dirPath</ObjectName>
      <AbsolutePath>\\secrets($|\\)</AbsolutePath>
    </MsDeploySkipRules>
    <MsDeploySkipRules Include="SkipSecretsFiles">
      <ObjectName>filePath</ObjectName>
      <AbsolutePath>\\secrets\\</AbsolutePath>
    </MsDeploySkipRules>
    <MsDeploySkipRules Include="SkipSpaFolder">
      <ObjectName>dirPath</ObjectName>
      <AbsolutePath>\\wwwroot($|\\)</AbsolutePath>
    </MsDeploySkipRules>
    <MsDeploySkipRules Include="SkipSpaFiles">
      <ObjectName>filePath</ObjectName>
      <AbsolutePath>\\wwwroot\\</AbsolutePath>
    </MsDeploySkipRules>
    <MsDeploySkipRules Include="SkipLogsFolder">
      <ObjectName>dirPath</ObjectName>
      <AbsolutePath>\\logs($|\\)</AbsolutePath>
    </MsDeploySkipRules>
    <MsDeploySkipRules Include="SkipLogsFiles">
      <ObjectName>filePath</ObjectName>
      <AbsolutePath>\\logs\\</AbsolutePath>
    </MsDeploySkipRules>
    <MsDeploySkipRules Include="SkipAcmeFolder">
      <ObjectName>dirPath</ObjectName>
      <AbsolutePath>\\\.well-known\\acme-challenge($|\\)</AbsolutePath>
    </MsDeploySkipRules>
    <MsDeploySkipRules Include="SkipAcmeFiles">
      <ObjectName>filePath</ObjectName>
      <AbsolutePath>\\\.well-known\\acme-challenge\\</AbsolutePath>
    </MsDeploySkipRules>
  </ItemGroup>
</Project>
