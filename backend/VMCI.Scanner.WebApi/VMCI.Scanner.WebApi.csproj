<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets Plesk's Let's Encrypt renewal reach /.well-known (docs/deployment.md). -->
    <Content Include=".well-known\web.config" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="Never" />
    <!-- A secrets\ folder here is only ever a server layout (SecretsFile.cs); never publish one by accident. -->
    <Content Remove="secrets\**" />
    <None Remove="secrets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VMCI.Scanner.DB\VMCI.Scanner.DB.csproj" />
    <ProjectReference Include="..\VMCI.Scanner.Shared\VMCI.Scanner.Shared.csproj" />
    <ProjectReference Include="..\VMCI.Scanner.Pdf\VMCI.Scanner.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Pinned explicitly: the 2.0.0 that Microsoft.AspNetCore.OpenApi pulls in transitively has
         advisory GHSA-v5pm-xwqc-g5wc. Keep at 2.11.0 or later. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

</Project>
